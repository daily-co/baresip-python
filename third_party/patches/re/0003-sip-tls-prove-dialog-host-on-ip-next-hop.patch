+static int tls_alt_name_idx = -1;
+static once_flag alt_name_oflag = ONCE_FLAG_INIT;
+
+
+/* Called by OpenSSL when the SSL object is freed: release its name. */
+static void alt_name_free(void *parent, void *ptr, CRYPTO_EX_DATA *ad,
+			  int idx, long argl, void *argp)
+{
+	(void)parent;
+	(void)ad;
+	(void)idx;
+	(void)argl;
+	(void)argp;
+
+	mem_deref(ptr);
+}
+
+
+static void tls_init_alt_name_idx(void)
+{
+	tls_alt_name_idx = SSL_get_ex_new_index(0, "tls alt name",
+						NULL, NULL, alt_name_free);
+}
+
+
+/*
+ * A server reached by its IP address may prove the alternative name
+ * instead. Only the address mismatch of the server's own certificate is
+ * accepted, and only for a certificate valid for that name; every other
+ * error is handled as usual.
+ */
+static int tls_verify_handler_alt(int ok, X509_STORE_CTX *ctx)
+{
+	/* OpenSSL calls this for each check that fails; returning 1 lets
+	   verification go on to the checks that follow (validity dates,
+	   signatures), returning 0 ends it. */
+	if (!ok &&
+	    X509_STORE_CTX_get_error(ctx) == X509_V_ERR_IP_ADDRESS_MISMATCH &&
+	    X509_STORE_CTX_get_error_depth(ctx) == 0) {
+
+		SSL *ssl = X509_STORE_CTX_get_ex_data(ctx,
+				SSL_get_ex_data_X509_STORE_CTX_idx());
+		const char *name = ssl ?
+			SSL_get_ex_data(ssl, tls_alt_name_idx) : NULL;
+		X509 *leaf = X509_STORE_CTX_get0_cert(ctx);
+
+		if (name && leaf &&
+		    1 == X509_check_host(leaf, name, 0,
+					 X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS,
+					 NULL)) {
+			X509_STORE_CTX_set_error(ctx, X509_V_OK);
+			return 1;
+		}
+	}
+
+	return tls_verify_handler(ok, ctx);
+}
+
+
+/**
+ * Enable verification of a server reached by its IP address that may
+ * prove a host name instead
+ *
+ * The server certificate is accepted when it is valid for the IP
+ * address or for the host name. The host name is sent as SNI.
+ *
+ * @param tc   TLS Connection
+ * @param ip   IP address the connection is made to
+ * @param name Host name the server may prove instead
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int tls_set_verify_server_alt(struct tls_conn *tc, const char *ip,
+			      const char *name)
+{
+	char *copy;
+	void *old;
+	int err;
+
+	if (!tc || !ip || !name)
+		return EINVAL;
+
+	if (!tc->tls->verify_server)
+		return 0;
+
+	call_once(&alt_name_oflag, tls_init_alt_name_idx);
+	if (tls_alt_name_idx < 0)
+		return ENOMEM;
+
+	/* the check as for any IP address: its failure is what the
+	   handler may forgive */
+	if (!X509_VERIFY_PARAM_set1_ip_asc(SSL_get0_param(tc->ssl), ip)) {
+		DEBUG_WARNING("X509_VERIFY_PARAM_set1_ip_asc error\n");
+		ERR_clear_error();
+		return EPROTO;
+	}
+
+	/* SNI, so a server with several certificates presents this one */
+	if (!SSL_set_tlsext_host_name(tc->ssl, name)) {
+		DEBUG_WARNING("SSL_set_tlsext_host_name error\n");
+		ERR_clear_error();
+		return EPROTO;
+	}
+
+	/* the name travels with the SSL object, where the handler finds it */
+	err = str_dup(&copy, name);
+	if (err)
+		return err;
+
+	old = SSL_get_ex_data(tc->ssl, tls_alt_name_idx);
+	if (!SSL_set_ex_data(tc->ssl, tls_alt_name_idx, copy)) {
+		mem_deref(copy);
+		ERR_clear_error();
+		return ENOMEM;
+	}
+	mem_deref(old);
+
+	SSL_set_verify(tc->ssl, SSL_VERIFY_PEER, tls_verify_handler_alt);
+
+	return 0;
+}
