+/*
+ * The host name of the first hop this side configured, which a later
+ * TLS connection of the dialog to an IP address may prove instead.
+ */
+static int tls_host_from_route(struct sip_dialog *dlg)
+{
+	struct pl pl;
+	struct sa sa;
+
+	if (msg_param_decode(&dlg->route.params, "maddr", &pl))
+		pl = dlg->route.host;
+
+	if (!pl_isset(&pl) || !sa_set(&sa, &pl, 0))
+		return 0;
+
+	return pl_strdup(&dlg->tls_host, &pl);
 }
 
 
