+/**
+ * Get the host name of the dialog this side opened the TLS connection of
+ * a SIP message for: the name this side configured, never one a peer
+ * named
+ *
+ * @param msg SIP message
+ *
+ * @return Host name, NULL if none
+ */
+const char *sip_msg_tls_host(const struct sip_msg *msg)
+{
+	if (!msg || !msg->sock || msg->tp != SIP_TRANSP_TLS)
+		return NULL;
+
+	return ((struct sip_conn *)msg->sock)->host;
+}
